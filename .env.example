# SAMS Dokumenten- & Aktensystem – Konfiguration
# Kopieren nach ".env" und anpassen (cp .env.example .env).

# Öffentliche Adresse ohne abschließenden Slash (für QR-Codes und Prüflinks)
APP_URL=https://sams.example.com
APP_TIMEZONE=Europe/Berlin
# Fehlerdetails im Browser anzeigen (nur zum Entwickeln auf true setzen)
APP_DEBUG=false

# Datenbank: mysql (empfohlen) oder sqlite (nur zum Testen)
DB_DRIVER=mysql
# Bei Docker: "db" (Name des Datenbank-Containers)
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sams
DB_USERNAME=sams
DB_PASSWORD=bitte-aendern
# Nur für Docker: Root-Passwort des MariaDB-Containers
DB_ROOT_PASSWORD=bitte-auch-aendern
# Nur bei sqlite: Pfad relativ zum Projektordner
DB_SQLITE_PATH=storage/sams.sqlite

# Session-Cookie: auto (Standard: bei HTTPS "None", damit das Ingame-Tablet das System einbetten kann, sonst "Lax"),
# Lax oder None. Alle Formulare sind zusätzlich durch CSRF-Tokens geschützt.
SESSION_SAMESITE=auto

# API-Schlüssel für die FiveM-Resource (leer = API deaktiviert). Erzeugen z. B. mit: openssl rand -hex 24
API_KEY=

# --- Auto-Update ---------------------------------------------------------
# Branch, dem der Server folgt
UPDATE_BRANCH=main
UPDATE_REMOTE=origin
# Wie PHP-Befehle ausgeführt werden. Ohne Docker: php
# Mit Docker: docker compose exec -T app php
UPDATE_PHP_CMD=php
# Optional: Befehl nach erfolgreichem Update (z. B. "systemctl reload php8.3-fpm")
UPDATE_RELOAD_CMD=
# Optional: Geheimnis für den GitHub-Webhook (sofortiges Update statt Warten auf den Timer)
UPDATE_WEBHOOK_SECRET=
# Optional: Discord-Webhook für Update-Meldungen
UPDATE_DISCORD_WEBHOOK=

# --- Backups -------------------------------------------------------------
# Wie viele Tage Backups aufbewahrt werden
BACKUP_KEEP_DAYS=14

# --- Discord (Bürgerportal-Login, Mitarbeiter-Login, Rollen-Sync) --------
# Discord-Anwendung anlegen: https://discord.com/developers/applications → OAuth2
# Redirect-URIs eintragen: APP_URL/portal.php?action=callback und APP_URL/index.php?p=discord_login
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional für Rollen-Sync: Bot-Token und Server-ID (Bot muss auf dem Server sein, Recht „Mitglieder anzeigen“)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# NUR ZUM TESTEN: Bürgerportal ohne Discord (Anmeldung mit beliebiger ID). Im Live-Betrieb immer false!
PORTAL_DEV_LOGIN=false

# Optional: Wer darf das System einbetten? Leer = keine Einschränkung (Standard).
# Beispiel nur eigene Seiten + Ingame-Tablet: 'self' https://cfx-nui-sams_tablet nui://sams_tablet
FRAME_ANCESTORS=
