#!/usr/bin/env php
<?php
/**
 * SAMS Kommandozeile
 *
 *   php bin/sams status                     Version, Datenbank, offene Migrationen
 *   php bin/sams migrate                    Offene Datenbank-Migrationen ausführen
 *   php bin/sams create-admin [benutzer]    Hauptadministrator anlegen (fragt Name und Passwort ab)
 *   php bin/sams reset-password <benutzer>  Notfall: Einmalpasswort setzen, Sperre/2FA aufheben
 *   php bin/sams backup [tag]               Datenbank-Backup erstellen
 *   php bin/sams backups                    Vorhandene Backups auflisten
 *   php bin/sams restore <datei>            Backup einspielen (überschreibt die Datenbank!)
 *   php bin/sams maintenance on|off         Wartungsmodus ein-/ausschalten
 *   php bin/sams update:request             Sofortige Update-Prüfung anfordern
 *   php bin/sams selftest                   Selbsttest (Syntax, Datenbank, Dokumentvorlagen) – läuft nach jedem Update
 *   php bin/sams cron                       Regelmäßige Aufgaben (läuft mit dem Update-Timer mit):
 *                                           Discord-Nachrichten senden, Berichte, Rollen-Sync, Dienstzeiten
 *   php bin/sams report weekly|monthly      Bericht sofort nach Discord senden (letzte Woche / letzter Monat)
 */
declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    exit(1);
}

require dirname(__DIR__) . '/app/bootstrap.php';
require SAMS_ROOT . '/app/backup.php';

$cmd = $argv[1] ?? 'help';
$args = array_slice($argv, 2);
$out = fn(string $m) => fwrite(STDOUT, $m . PHP_EOL);

function ask(string $question, bool $hidden = false): string
{
    fwrite(STDOUT, $question);
    if ($hidden && DIRECTORY_SEPARATOR === '/' && stream_isatty(STDIN)) {
        system('stty -echo');
        $value = trim((string) fgets(STDIN));
        system('stty echo');
        fwrite(STDOUT, PHP_EOL);
        return $value;
    }
    return trim((string) fgets(STDIN));
}

switch ($cmd) {
    case 'status':
        $g = git_version();
        $out('SAMS ' . version_label() . ($g['branch'] ? ' · Branch ' . $g['branch'] : ''));
        try {
            db()->query('SELECT 1');
            $out('Datenbank: ' . db_driver() . ' – verbunden');
            $pending = pending_migrations();
            $out('Migrationen: ' . (count($pending) ? count($pending) . ' offen (' . implode(', ', $pending) . ')' : 'aktuell'));
            $out('Benutzer: ' . (int) scalar('SELECT COUNT(*) FROM users'));
        } catch (Throwable $e) {
            $out('Datenbank: FEHLER – ' . $e->getMessage());
        }
        $out('Wartungsmodus: ' . (in_maintenance() ? 'AN' : 'aus'));
        $last = update_status();
        if ($last) {
            $out('Letztes Update: ' . ($last['finished_at'] ?? '?') . ' – ' . ($last['status'] ?? '?') . ' ' . ($last['to'] ?? ''));
        }
        break;

    case 'migrate':
        run_migrations($out);
        break;

    case 'create-admin':
        run_migrations(fn() => null);
        $username = $args[0] ?? ask('Benutzername: ');
        if (!preg_match('/^[A-Za-z0-9._\-]{3,40}$/', $username)) {
            $out('Ungültiger Benutzername.');
            exit(1);
        }
        if (scalar('SELECT id FROM users WHERE username = ?', [$username])) {
            $out('Benutzername existiert bereits.');
            exit(1);
        }
        $name = ask('Name (Vorname Nachname): ');
        $password = ask('Passwort (min. 10 Zeichen): ', true);
        if (password_problems($password, $username) || $name === '') {
            $out('Name fehlt oder Passwort zu kurz/zu einfach (min. 10 Zeichen).');
            exit(1);
        }
        insert('users', [
            'username' => $username, 'password_hash' => password_hash($password, PASSWORD_DEFAULT),
            'name' => $name, 'title' => '', 'role' => 'admin', 'created_at' => now(), 'password_changed_at' => now(),
            'rank_id' => scalar('SELECT id FROM ranks ORDER BY level DESC LIMIT 1'), 'is_superadmin' => 1,
        ]);
        $out("Hauptadministrator \"$username\" angelegt.");
        break;

    case 'reset-password':
        $u = one('SELECT * FROM users WHERE username = ?', [$args[0] ?? '']);
        if (!$u) {
            $out('Benutzer nicht gefunden.');
            exit(1);
        }
        $pw = generate_password();
        update('users', (int) $u['id'], [
            'password_hash' => password_hash($pw, PASSWORD_DEFAULT), 'must_change_password' => 1, 'active' => 1,
            'totp_enabled' => 0, 'totp_secret' => '', 'recovery_codes' => '',
        ]);
        end_sessions((int) $u['id']);
        q("DELETE FROM login_attempts WHERE username = ?", [$u['username']]);
        audit('user.password_reset', 'user', (int) $u['id'], $u['username'] . ' – über Kommandozeile');
        $out("Einmalpasswort für {$u['username']}: $pw");
        $out('Konto entsperrt, 2FA zurückgesetzt. Beim Login muss ein neues Passwort festgelegt werden.');
        break;

    case 'backup':
        $file = create_backup($args[0] ?? '');
        $out('Backup erstellt: ' . $file);
        break;

    case 'backups':
        foreach (list_backups() as $b) {
            $out(sprintf('%s  %s  %8.1f KB', date('Y-m-d H:i', $b['time']), $b['file'], $b['size'] / 1024));
        }
        break;

    case 'restore':
        if (empty($args[0])) {
            $out('Bitte Backup-Datei angeben (siehe: php bin/sams backups).');
            exit(1);
        }
        if (!in_array('--force', $args, true) && strtolower(ask('Datenbank wird überschrieben. Fortfahren? (ja/nein) ')) !== 'ja') {
            exit(1);
        }
        restore_backup($args[0]);
        $out('Backup eingespielt.');
        break;

    case 'maintenance':
        set_maintenance(($args[0] ?? '') === 'on', 'manuell');
        $out('Wartungsmodus: ' . (in_maintenance() ? 'AN' : 'aus'));
        break;

    case 'update:request':
        request_update('cli');
        $out('Update-Prüfung angefordert. Der Update-Timer übernimmt beim nächsten Lauf.');
        break;

    case 'selftest':
        $errors = [];
        // 1. Syntax aller PHP-Dateien
        $it = new RecursiveIteratorIterator(new RecursiveDirectoryIterator(SAMS_ROOT, FilesystemIterator::SKIP_DOTS));
        foreach ($it as $file) {
            $path = $file->getPathname();
            if (!str_ends_with($path, '.php') || preg_match('#/(vendor|storage|node_modules|\.git)/#', $path)) {
                continue;
            }
            exec(escapeshellarg(PHP_BINARY) . ' -l ' . escapeshellarg($path) . ' 2>&1', $o, $rc);
            if ($rc !== 0) {
                $errors[] = 'Syntaxfehler: ' . substr($path, strlen(SAMS_ROOT) + 1);
            }
        }
        // 2. Datenbank und Migrationen
        try {
            scalar('SELECT COUNT(*) FROM users');
            if ($p = pending_migrations()) {
                $errors[] = 'Offene Migrationen: ' . implode(', ', $p);
            }
        } catch (Throwable $e) {
            $errors[] = 'Datenbank: ' . $e->getMessage();
        }
        // 3. Jede Dokumentart einmal mit Standardwerten rendern
        $u = ['id' => 0, 'name' => 'Selbsttest', 'title' => '', 'rank_name' => '', 'department' => '', 'badge_number' => '', 'doctor_number' => '', 'signature' => ''];
        foreach (document_types() as $key => $t) {
            $data = [];
            foreach ($t['fields'] as $f) {
                if (isset($f['name'])) {
                    $data[$f['name']] = field_default($f);
                }
            }
            try {
                ob_start();
                render_document(['id' => 0, 'type' => $key, 'number' => 'TEST', 'data' => $data, 'patient_snapshot' => [], 'issuer_snapshot' => $u,
                    'verify_code' => 'TEST0000', 'status' => 'valid', 'issued_at' => now()], ['draft' => true]);
                ob_end_clean();
            } catch (Throwable $e) {
                ob_end_clean();
                $errors[] = "Vorlage $key: " . $e->getMessage();
            }
        }
        foreach ($errors as $err) {
            fwrite(STDERR, $err . PHP_EOL);
        }
        $out($errors ? 'Selbsttest FEHLGESCHLAGEN (' . count($errors) . ')' : 'Selbsttest ok');
        exit($errors ? 1 : 0);

    case 'cron':
        duty_autoclose();
        // Wochenbericht montags ab 8 Uhr für die Vorwoche, Monatsbericht am 1. ab 8 Uhr
        if ((int) date('G') >= 8) {
            if (setting('report_weekly', '0') === '1' && date('N') === '1' && setting('report_last_weekly') !== date('o-W')) {
                [$f, $t, $label] = stats_period('lastweek');
                notify_webhook('reports', stats_discord_embed(stats_collect($f, $t), $label));
                save_setting('report_last_weekly', date('o-W'));
                $out('Wochenbericht ' . $label . ' eingereiht.');
            }
            if (setting('report_monthly', '0') === '1' && date('j') === '1' && setting('report_last_monthly') !== date('Y-m')) {
                [$f, $t, $label] = stats_period('lastmonth');
                notify_webhook('reports', stats_discord_embed(stats_collect($f, $t), $label));
                save_setting('report_last_monthly', date('Y-m'));
                $out('Monatsbericht ' . $label . ' eingereiht.');
            }
        }
        // Rollen-Sync stündlich
        if (discord_role_map() && time() - (int) setting('discord_last_sync', '0') >= 3600) {
            save_setting('discord_last_sync', (string) time());
            foreach (discord_sync_all() as $c) {
                $out('Rollen-Sync: ' . $c);
            }
        }
        if ($r = roster_cron()) {
            $out("Dienstplan: $r Erinnerung(en)/Warnung(en).");
        }
        $n = discord_flush(100);
        if ($n) {
            $out("$n Discord-Nachricht(en) gesendet.");
        }
        break;

    case 'report':
        [$f, $t, $label] = stats_period(($args[0] ?? 'weekly') === 'monthly' ? 'lastmonth' : 'lastweek');
        notify_webhook('reports', stats_discord_embed(stats_collect($f, $t), $label));
        $out('Bericht ' . $label . ': ' . discord_flush(10) . ' Nachricht(en) gesendet' . (valid_webhook_url((string) setting('webhook_reports', '')) ? '.' : ' (kein Webhook für Berichte eingerichtet).'));
        break;

    default:
        $doc = file_get_contents(__FILE__);
        preg_match('#/\*\*(.*?)\*/#s', $doc, $m);
        $out(trim(preg_replace('/^\s*\* ?/m', '', $m[1] ?? '')));
}
